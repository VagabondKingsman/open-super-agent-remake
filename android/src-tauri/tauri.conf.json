{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Super Agent",
  "version": "0.17.0",
  "identifier": "com.kadaliao.opensuperagent",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
